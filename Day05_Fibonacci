public class Day05_Fibonacci{
    public static int fibo(int n) {
        int frt=0;
        int nxt=1;
        int sum=0;
        if(n==0){
            return 0;
        }
        if(n==1){
            return 1;
        }
        for(int i=2;i<=n;i++){
            sum=frt+nxt;
            frt=nxt;
            nxt=sum;
        }
        return nxt;
    }
public static void main(String[]args){
	int n=2;
	System.out.println(fibo(n));
}
}
